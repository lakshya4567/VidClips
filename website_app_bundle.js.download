sample_businesses:"Tai yra DI sugeneruoti verslo pavyzd\u017eiai su bendro pob\u016bd\u017eio i\u0161galvotais \u012fmoni\u0173 pavadinimais. J\u016bs esate atsakingi u\u017e galutini\u0173 rezultat\u0173 tikslumo ir teis\u0117tumo patikrinim\u0105.","settings.help_title":"Pad\u0117kite tobulinti \u201ePomelli\u201c visiems","settings.help_on":"Leiskite, kad j\u016bs\u0173 duomenys (\u012fskaitant j\u016bs\u0173 verslo DNR ir kampanij\u0173 duomenis) b\u016bt\u0173 naudojami \u201eGoogle\u201c generatyvinio DI modeli\u0173 mokymui \u2013 tai pad\u0117s patobulinti \u201ePomelli\u201c jums ir kitiems naudotojams. Mes imam\u0117s priemoni\u0173 j\u016bs\u0173 privatumui apsaugoti.",
"settings.learn_more":"Su\u017einokite daugiau","settings.help_on_tail":"Kai \u0161is nustatymas i\u0161jungtas, j\u016bs\u0173 duomenys vis tiek gali b\u016bti naudojami siekiant geriau aptikti suk\u010diavim\u0105, piktnaud\u017eiavim\u0105 ir","settings.help_off":"J\u016bs\u0173 b\u016bsimi duomenys nebus naudojami \u201eGoogle\u201c generatyvinio DI modeliams tobulinti, i\u0161skyrus atvejus, kai siun\u010diate atsiliepimus. Anonimizuoti pavyzd\u017eiai, kuriuos jau per\u017ei\u016br\u0117jo tikrinantys \u017emon\u0117s, saugomi iki trej\u0173 met\u0173, net jei juos i\u0161trinsite.",
"settings.help_off_tail":"Kai \u0161is nustatymas i\u0161jungtas, j\u016bs\u0173 duomenys vis tiek gali b\u016bti naudojami siekiant geriau nustatyti suk\u010diavim\u0105, piktnaud\u017eiavim\u0105 ir","privacy.google_tos":"\u201eGoogle\u201c paslaug\u0173 teikimo s\u0105lyg\u0173","privacy.prohibited_policy":"draud\u017eiamo naudojimo politikos pa\u017eeidimus bei \u012f juos reaguoti","tos.and":"bei","settings.title":"Paskyros nustatymai","settings.subtitle":"Per\u017ei\u016br\u0117kite ir redaguokite savo paskyros nustatymus",
