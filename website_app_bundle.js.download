"website.publish.rights_disclaimer":"\u0642\u0628\u0644 \u0627\u0644\u0646\u0634\u0631\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646\u0651 \u0644\u062f\u064a\u0643 \u0643\u0627\u0641\u0629 \u0627\u0644\u062d\u0642\u0648\u0642 \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u0642\u062f\u0645 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639.",
