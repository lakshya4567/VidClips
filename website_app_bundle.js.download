"marketing.title":"\u0627\u0644\u0628\u0642\u0627\u0621 \u0639\u0644\u0649 \u062a\u0648\u0627\u0635\u0644","marketing.subtitle":"\u0644\u0645\u0633\u0627\u0639\u062f\u062a\u0646\u0627 \u0641\u064a \u062a\u062d\u0633\u064a\u0646 \u062a\u062c\u0631\u0628\u062a\u0643\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0627\u0644\u0628\u064a\u0627\u0646 \u0627\u0644\u062a\u0627\u0644\u064a:","marketing.email_optin":"\u0623\u0648\u062f \u0627\u0633\u062a\u0644\u0627\u0645 \u0631\u0633\u0627\u0626\u0644 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0628\u0622\u062e\u0631 \u0627\u0644\u0645\u0633\u062a\u062c\u062f\u0627\u062a \u0648\u0627\u0644\u0639\u0631\u0648\u0636 \u0648\u0627\u0644\u0646\u0635\u0627\u0626\u062d \u0648\u0627\u0644\u0623\u062e\u0628\u0627\u0631 \u0639\u0646 Pomelli",
