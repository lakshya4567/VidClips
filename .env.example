APP_NAME=video_ai_project
ENVIRONMENT=dev
LOG_LEVEL=INFO

DEVICE=auto
NUM_WORKERS=4
BATCH_SIZE=8
MAX_FRAME_DIM=1280
FRAME_SAMPLE_STRIDE=1

ENABLE_SCENE_DETECTION=true
ENABLE_CAMERA_MOTION=true
ENABLE_OBJECT_DETECTION=true
ENABLE_SEGMENTATION=true
ENABLE_FACE_POSE=true
ENABLE_OCR=true
ENABLE_DEPTH=true
ENABLE_COLOR_GRADING=true
ENABLE_AUDIO=true

API_HOST=0.0.0.0
API_PORT=8000

AUTO_DOWNLOAD_MODELS=true

# Required for pyannote speaker diarization (gated HF model):
# HF_TOKEN=hf_xxx
